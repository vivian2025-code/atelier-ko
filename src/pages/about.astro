---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/atelier-workshop.jpg";
import { siteConfig, pageTitle } from "@/config/site";

const principles = [
  {
    heading: "No app required",
    copy: "Our trackers connect seamlessly without forcing users to download bloated applications, ensuring a smooth out-of-the-box experience.",
  },
  {
    heading: "Universal compatibility",
    copy: "Designed to work effortlessly with both iOS and Android ecosystems for maximum market reach and customer convenience.",
  },
  {
    heading: "Certified quality",
    copy: "Backed by standard CE and FCC compliance, with additional voluntary certifications available upon request to guarantee reliability.",
  },
];

const facts = [
  { value: "2024", label: "Founded" },
  { value: "CE/FCC", label: "Certified" },
  { value: "iOS/And", label: "Compatible" },
  { value: "Bulk", label: "Wholesale" },
];
---

<BaseLayout
  title={pageTitle("The Studio")}
  description="Mass Power provides innovative, universal trackers compatible with both iOS and Android. Wholesale suppliers with certified quality."
  image={workshopImg}
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[11ch]">Find Peace of Mind: Effortlessly Track Your Valuables Anywhere!</h1>
      <p class="type-lead hero-in mt-8 max-w-[58ch]" style="--reveal-delay:120ms">
        Mass Power was founded in 2024, with the aim of delivering products that bring value to people.
        Our AirTag-type trackers require no app download and are compatible with both iOS and Android.
      </p>
    </section>

    <figure class="hero-in overflow-hidden bg-surface" style="--reveal-delay:260ms">
      <Image
        src={workshopImg}
        alt="Mass Power trackers and modern smart technology setup"
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        decoding="sync"
        class="parallax h-[50vh] w-full object-cover md:h-[72vh]"
      />
    </figure>

    {/* -------------------------------------------------------------- Origin */}
    <section class="shell mt-24 grid gap-8 md:mt-36 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <h2 class="type-h2 max-w-[12ch]">Who we are?</h2>
      </div>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:120ms">
        <p class="type-body">
          Mass Power was founded in 2024, specializes in AirTag-type trackers and provides a range of authentication certificates, including CE and FCC compliance.
          The Company also offers additional voluntary certifications upon customer request to ensure quality and reliability.
        </p>
        <p class="type-body mt-5">
          We believe in creating solutions that are not only functional but also durable and user-friendly.
        </p>
      </div>
    </section>

    {/* ---------------------------------------------------------- Principles */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[16ch]" data-reveal>How we work</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          principles.map((principle, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <h3 class="type-h3">{principle.heading}</h3>
              <p class="type-body mt-4 text-[0.9375rem]">{principle.copy}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ----------------------------------------------------------- Materials */}
    <section class="shell mt-24 grid items-center gap-10 md:mt-36 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <div class="overflow-hidden bg-surface" data-reveal="mask">
          <div>
            <Image
              src={handsImg}
              alt="Close-up of smart device inspection and quality control"
              width={1080}
              height={1440}
              format="webp"
              loading="lazy"
              class="aspect-[3/4] w-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:140ms">
        <blockquote>
          <p class="type-h3 max-w-[26ch] text-[clamp(1.5rem,2.8vw,2.25rem)] leading-[1.15]">
            We support customized designs. The feasibility depends on your specific design requirements. Certain components can be customized, whereas others are not adjustable.
          </p>
          <footer class="label mt-6"></footer>
        </blockquote>
        <p class="type-body mt-8 max-w-[48ch] border-t border-line pt-6 text-[0.9375rem]">
          As a wholesale supplier, we do not operate as a retail store; however, sample orders are available prior to placing a bulk order. 
          Please note that sample costs and shipping fees are the responsibility of the buyer.
        </p>
      </div>
    </section>

    {/* --------------------------------------------------------------- Facts */}
    <section class="mt-24 border-y border-line md:mt-36" aria-label="Studio at a glance">
      <dl class="shell grid grid-cols-2 md:grid-cols-4">
        {
          facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ----------------------------------------------------------------- CTA */}
    <section id="studio" class="shell mt-24 md:mt-36">
      <div class="grid items-end gap-8 md:grid-cols-12" data-reveal>
        <div class="md:col-span-7">
          <h2 class="type-h2 max-w-[16ch]">Check out our online catalog or contact us today</h2>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href="/catalog" class="btn btn-primary">See the catalogue</a>
          <a href={`mailto:${siteConfig.email}`} class="btn btn-outline">Write to us</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>