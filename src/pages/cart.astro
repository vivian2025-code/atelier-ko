---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, pageTitle } from "@/config/site";
---

<BaseLayout
  title={pageTitle("Start a conversation")}
  description={`Reach out directly to ${siteConfig.name} to discuss available works, questions, or custom pieces.`}
>
  <main id="main-content" class="shell py-12 md:py-20">
    <div class="mx-auto max-w-3xl">
      <header class="border-b border-line pb-10">
        <p class="mono text-[0.6875rem] uppercase tracking-[0.05em] text-muted">Direct Studio Dialogue</p>
        <h1 class="type-h1 mt-3">Let's talk about a piece</h1>
        <p class="type-body mt-4 text-muted max-w-[52ch]">
          My work is meant to be lived with and discussed. Whether you have questions about a specific piece, need custom dimensions, or just want to talk about how it fits your space, write to me directly.
        </p>
      </header>

      <form 
        name="studio-conversation" 
        method="POST" 
        data-netlify="true" 
        class="mt-12 space-y-10"
      >
        <input type="hidden" name="form-name" value="studio-conversation" />

        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <label class="field-label" for="from-name">Your name</label>
            <input
              id="from-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Astrid Lindgren"
              class="field mono mt-2"
            />
          </div>
          <div>
            <label class="field-label" for="from-email">Your email</label>
            <input
              id="from-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="astrid@example.com"
              class="field mono mt-2"
            />
          </div>
        </div>

        <div>
          <label class="field-label" for="piece-ref">Which piece or idea are you looking at?</label>
          <input
            id="piece-ref"
            name="subject"
            type="text"
            placeholder="e.g., Low Bench in Walnut, or a custom commission"
            class="field mono mt-2"
            data-piece-input
          />
        </div>

        <div>
          <label class="field-label" for="conversation-message">What would you like to discuss?</label>
          <textarea
            id="conversation-message"
            name="message"
            rows="6"
            required
            placeholder="Tell me about your space, questions you have, or what caught your eye..."
            class="field mono mt-2 resize-none"
          ></textarea>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 pt-4 border-t border-line">
          <button type="submit" class="btn btn-primary">
            Start the conversation
          </button>
          
          <p class="mono text-[0.6875rem] tracking-[0.05em] text-muted">
            Or email directly at <a href={`mailto:${siteConfig.email || 'xxx@xx.com'}`} class="link underline">{siteConfig.email || 'xxx@xx.com'}</a>
          </p>
        </div>
      </form>
    </div>
  </main>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const piece = params.get("piece");
      if (piece) {
        const input = document.querySelector("[data-piece-input]");
        if (input) {
          input.value = piece;
        }
      }
    })();
  </script>
</BaseLayout>